# Copy to .env for local overrides (.env is gitignored; .env.example is committed).
#
# Where the app sends /api/advise requests. Leave unset for simulator work and
# the app falls back to a local backend automatically.
#
# EXPO_PUBLIC_* is inlined into the JS bundle at build time, so anyone with the
# app can read this value. That is fine for a URL. Never put the Gemini API key
# here -- it belongs on the server (backend/.env locally, Render dashboard in
# production).
#
# EXPO_PUBLIC_API_URL=https://verse-api.onrender.com
